// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String   @id @default(cuid())
  onboardingCompleted Boolean  @default(false)

  // Authentication
  email    String @unique
  password String

  // Basic profile
  name   String
  age    Int?
  gender String?
  bio    String?

  // Personal details
  height     Int?
  occupation String?
  location   String?

  // Profile images
  images UserImage[]

  // Swipes
  sentSwipes     Swipe[] @relation("UserSwipes")
  receivedSwipes Swipe[] @relation("ReceivedSwipes")

  // Matches
  matchesAsUser1 Match[] @relation("UserMatches1")
  matchesAsUser2 Match[] @relation("UserMatches2")

  // Conversations
  conversationsAsUser1 Conversation[] @relation("ConversationUser1")
  conversationsAsUser2 Conversation[] @relation("ConversationUser2")

  // Messages sent by this user
  sentMessages Message[]

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserImage {
  id String @id @default(cuid())

  // Cloudinary image URL
  url String

  // 1 = profile/main photo, 2-6 = additional photos
  position Int

  // Relationship with User
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Timestamp
  createdAt DateTime @default(now())

  // A user cannot have two images in the same position
  @@unique([userId, position])
}

model Swipe {
  id        String   @id @default(cuid())
  action    String
  userId    String
  targetId  String
  createdAt DateTime @default(now())

  user   User @relation("UserSwipes", fields: [userId], references: [id], onDelete: Cascade)
  target User @relation("ReceivedSwipes", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([userId, targetId])
}

model Match {
  id        String   @id @default(cuid())
  user1Id   String
  user2Id   String
  createdAt DateTime @default(now())

  user1 User @relation("UserMatches1", fields: [user1Id], references: [id], onDelete: Cascade)
  user2 User @relation("UserMatches2", fields: [user2Id], references: [id], onDelete: Cascade)

  @@unique([user1Id, user2Id])
}

model Conversation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user1Id String
  user2Id String

  user1 User @relation("ConversationUser1", fields: [user1Id], references: [id], onDelete: Cascade)
  user2 User @relation("ConversationUser2", fields: [user2Id], references: [id], onDelete: Cascade)

  messages Message[]

  @@unique([user1Id, user2Id])
}

model Message {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderId String
  sender   User   @relation(fields: [senderId], references: [id], onDelete: Cascade)
}