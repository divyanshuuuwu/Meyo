
// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  onboardingCompleted Boolean @default(false)
  // Authentication
  email     String   @unique
  password  String

  // Basic profile
  name      String
  age       Int?
  gender    String?
  bio       String?

  // Personal details
  height     Int?     // height in cm
  occupation String?
  location   String?

  // Profile images
  images UserImage[]

  // swipes
  sentSwipes     Swipe[] @relation("UserSwipes")
  receivedSwipes Swipe[] @relation("ReceivedSwipes")

  matchesAsUser1 Match[] @relation("UserMatches1")
  matchesAsUser2 Match[] @relation("UserMatches2")

  
  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserImage {
  id        String   @id @default(cuid())

  // Cloudinary image URL
  url       String

  // 1 = profile/main photo, 2-6 = additional photos
  position  Int

  // Relationship with User
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Timestamp
  createdAt DateTime @default(now())

  // A user cannot have two images in the same position
  @@unique([userId, position])
}


model Swipe {
  id        String   @id @default(cuid())
  action    String
  userId    String
  targetId  String
  createdAt DateTime @default(now())

  user   User @relation("UserSwipes", fields: [userId], references: [id], onDelete: Cascade)
  target User @relation("ReceivedSwipes", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([userId, targetId])
}



model Match {
  id        String   @id @default(cuid())
  user1Id   String
  user2Id   String
  createdAt DateTime @default(now())

  user1 User @relation("UserMatches1", fields: [user1Id], references: [id], onDelete: Cascade)
  user2 User @relation("UserMatches2", fields: [user2Id], references: [id], onDelete: Cascade)

  @@unique([user1Id, user2Id])
}