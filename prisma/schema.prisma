
// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())

  // Authentication
  email     String   @unique
  password  String

  // Basic profile
  name      String
  age       Int?
  gender    String?
  bio       String?

  // Personal details
  height     Int?     // height in cm
  occupation String?
  location   String?

  // Profile images
  images UserImage[]

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserImage {
  id        String   @id @default(cuid())

  // Cloudinary image URL
  url       String

  // 1 = profile/main photo, 2-6 = additional photos
  position  Int

  // Relationship with User
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Timestamp
  createdAt DateTime @default(now())

  // A user cannot have two images in the same position
  @@unique([userId, position])
}

